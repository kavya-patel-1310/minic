//! native
// Integer algorithms: gcd, fast exponentiation, primality, Collatz, digit sums.
fn gcd(a, b) {
    while (b != 0) {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}

fn power(base, exp, mod) {
    let result = 1;
    base = base % mod;
    while (exp > 0) {
        if (exp % 2 == 1) result = result * base % mod;
        base = base * base % mod;
        exp = exp / 2;
    }
    return result;
}

fn isPrime(n) {
    if (n < 2) return false;
    for (let d = 2; d * d <= n; d += 1) {
        if (n % d == 0) return false;
    }
    return true;
}

fn collatzSteps(n) {
    let steps = 0;
    while (n != 1) {
        if (n % 2 == 0) n /= 2; else n = 3 * n + 1;
        steps += 1;
    }
    return steps;
}

fn digitSum(n) {
    let s = 0;
    while (n > 0) { s += n % 10; n /= 10; }
    return s;
}

print "gcd(1071, 462) =", gcd(1071, 462);
print "3^200 mod 1000000007 =", power(3, 200, 1000000007);

let count = 0;
let n = 0;
while (count < 15) {
    n += 1;
    if (!isPrime(n)) continue;
    print "prime #", count + 1, "is", n;
    count += 1;
}

let best = 0;
let bestN = 0;
for (let i = 1; i < 10000; i += 1) {
    let s = collatzSteps(i);
    if (s > best) { best = s; bestN = i; }
}
print "longest Collatz chain below 10000 starts at", bestN, "with", best, "steps";
print "digit sum of 9876543210 =", digitSum(9876543210);
