// N-Queens with backtracking: recursion + arrays.
let solutions = 0;

fn safe(cols, row, col) {
    for (let r = 0; r < row; r += 1) {
        let c = cols[r];
        if (c == col || abs(c - col) == row - r) return false;
    }
    return true;
}

fn solve(cols, row, n) {
    if (row == n) {
        solutions += 1;
        if (solutions == 1) show(cols, n);
        return nil;
    }
    for (let col = 0; col < n; col += 1) {
        if (safe(cols, row, col)) {
            cols[row] = col;
            solve(cols, row + 1, n);
        }
    }
}

fn show(cols, n) {
    for (let r = 0; r < n; r += 1) {
        let line = "";
        for (let c = 0; c < n; c += 1) {
            if (cols[r] == c) line += "Q "; else line += ". ";
        }
        print line;
    }
}

for (let n = 4; n <= 8; n += 1) {
    solutions = 0;
    if (n == 8) print "first solution for n = 8:";
    solve(array(n), 0, n);
    print n, "queens:", solutions, "solutions";
}
