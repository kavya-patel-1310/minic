// Conway's Game of Life on a small torus: nested arrays and string building.
let W = 20;
let H = 10;

fn makeGrid() {
    let g = [];
    for (let y = 0; y < H; y += 1) push(g, array(W, 0));
    return g;
}

fn neighbours(g, x, y) {
    let n = 0;
    for (let dy = -1; dy <= 1; dy += 1) {
        for (let dx = -1; dx <= 1; dx += 1) {
            if (dx == 0 && dy == 0) continue;
            n += g[(y + dy + H) % H][(x + dx + W) % W];
        }
    }
    return n;
}

fn step(g) {
    let next = makeGrid();
    for (let y = 0; y < H; y += 1) {
        for (let x = 0; x < W; x += 1) {
            let n = neighbours(g, x, y);
            if (n == 3 || (n == 2 && g[y][x] == 1)) next[y][x] = 1;
        }
    }
    return next;
}

fn render(g, gen) {
    print "generation", gen;
    for (let y = 0; y < H; y += 1) {
        let row = "";
        for (let x = 0; x < W; x += 1) {
            if (g[y][x] == 1) row += "#"; else row += ".";
        }
        print row;
    }
}

let grid = makeGrid();
// a glider and a blinker
grid[1][2] = 1; grid[2][3] = 1; grid[3][1] = 1; grid[3][2] = 1; grid[3][3] = 1;
grid[6][12] = 1; grid[6][13] = 1; grid[6][14] = 1;

for (let gen = 0; gen <= 8; gen += 4) {
    render(grid, gen);
    for (let k = 0; k < 4; k += 1) grid = step(grid);
}
